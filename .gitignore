# Environment
.venv/

# Secrets — mirror guard-paths.sh and tests/test_secrets.py; any committed
# .env.example/.sample/.template/.dist template stays tracked.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
secrets.toml
*.pem

# Python
__pycache__/

# Build artifacts
build/
dist/
*.egg-info/

# Tooling caches
.pytest_cache/
.ruff_cache/
.ty_cache/

# Claude Code (settings.json + hooks/ are tracked; personal overrides are not)
.claude/settings.local.json
.claude/.tests-pending

# macOS
.DS_Store

# Model weights and local data. Phase 2 downloads into the HF cache and
# Phase 5 keeps history outside the repo; these catch a misconfigured path.
# Never add *.png or *.webp: the README hero and examples/ must stay tracked.
*.safetensors
*.gguf
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
